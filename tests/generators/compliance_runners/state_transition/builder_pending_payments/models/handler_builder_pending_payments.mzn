include "../../aspects/base.mzn";
include "../../aspects/builder_payment_quorum.mzn";
enum QueueOccupancy = { EMPTY, SINGLE, MULTIPLE, FULL };
enum Count = { ZERO, ONE, MULTIPLE_COUNT };
enum Outcome = { NO_STATE_CHANGE, ROTATED_ONLY, APPENDED_ONE_AND_ROTATED, APPENDED_MULTIPLE_AND_ROTATED };
var QueueOccupancy: previous_epoch_occupancy;
var Dim: target_weight_to_quorum;
var BOOLV_NA: target_amount_nonzero;
var Count: qualifying_payment_count;
var bool: mixed_quorum_relations;
var QueueOccupancy: next_epoch_payments_occupancy;
var Count: preexisting_withdrawals_occupancy;
var Outcome: outcome;
var bool: state_effected;
constraint builder_payment_quorum_ok(target_weight_to_quorum, previous_epoch_occupancy != EMPTY);
constraint (target_amount_nonzero == NA) <-> previous_epoch_occupancy == EMPTY;
constraint (previous_epoch_occupancy == EMPTY) -> (qualifying_payment_count == ZERO /\ mixed_quorum_relations == false);
constraint (previous_epoch_occupancy == SINGLE) -> (qualifying_payment_count in {ZERO, ONE} /\ mixed_quorum_relations == false);
constraint (previous_epoch_occupancy == SINGLE /\ target_weight_to_quorum == LT) -> qualifying_payment_count == ZERO;
constraint (previous_epoch_occupancy == SINGLE /\ target_weight_to_quorum in {EQ, GT}) -> qualifying_payment_count == ONE;
constraint mixed_quorum_relations -> (previous_epoch_occupancy in {MULTIPLE, FULL} /\ qualifying_payment_count == MULTIPLE_COUNT /\ target_weight_to_quorum == LT);
constraint (previous_epoch_occupancy in {MULTIPLE, FULL} /\ target_weight_to_quorum in {EQ, GT}) -> qualifying_payment_count in {ONE, MULTIPLE_COUNT};
constraint (previous_epoch_occupancy == EMPTY /\ next_epoch_payments_occupancy == EMPTY) -> outcome == NO_STATE_CHANGE;
constraint (qualifying_payment_count == ZERO /\ (previous_epoch_occupancy != EMPTY \/ next_epoch_payments_occupancy != EMPTY)) -> outcome == ROTATED_ONLY;
constraint qualifying_payment_count == ONE -> outcome == APPENDED_ONE_AND_ROTATED;
constraint qualifying_payment_count == MULTIPLE_COUNT -> outcome == APPENDED_MULTIPLE_AND_ROTATED;
constraint state_effected <-> outcome != NO_STATE_CHANGE;
